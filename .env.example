# AccessGuard AI — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Auth ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_use_strong_password_here
SECRET_KEY=replace_with_64_char_random_hex_string

# ── Storage backend: "sqlite" (local) or "dynamodb" (AWS) ─────────────
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=./data/accessguard.db

# ── DynamoDB (only needed when STORAGE_BACKEND=dynamodb) ─────────────
DYNAMODB_REGION=ap-south-1
DYNAMODB_RECORDS_TABLE=accessguard-records
DYNAMODB_AUDIT_TABLE=accessguard-audit

# ── App ───────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# ── ML ────────────────────────────────────────────────────────────────
IF_CONTAMINATION=0.08
IF_N_ESTIMATORS=200
IF_RANDOM_STATE=42
